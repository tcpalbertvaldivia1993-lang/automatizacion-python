# Configuración del envío de informes por email.
# Copia este archivo como .env y rellénalo:   cp .env.ejemplo .env
# .env NO se sube a GitHub (está en .gitignore). Nunca pongas la contraseña en este archivo de ejemplo.

# Con Gmail: smtp.gmail.com y puerto 587.
# Con Outlook/Hotmail: smtp-mail.outlook.com y puerto 587.
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587

# Cuenta desde la que se envía.
EMAIL_USUARIO=tu_cuenta@gmail.com

# Con Gmail NO es tu contraseña normal: es una "contraseña de aplicación" de 16 letras.
# Se crea en https://myaccount.google.com/apppasswords (hace falta la verificación en dos pasos).
EMAIL_CONTRASENA=

# Quién recibe el informe. Varios: separados por comas.
EMAIL_DESTINO=tu_cuenta@gmail.com
