# Settings for sending the reports by email.
# Copy this file as .env and fill it in:   cp .env.example .env
# .env is NOT uploaded to GitHub (it's in .gitignore). Never put the password in this example file.

# With Gmail: smtp.gmail.com and port 587.
# With Outlook/Hotmail: smtp-mail.outlook.com and port 587.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Account the email is sent from.
EMAIL_USER=your_account@gmail.com

# With Gmail this is NOT your normal password: it's a 16-letter "app password".
# Create it at https://myaccount.google.com/apppasswords (2-step verification is required).
EMAIL_PASSWORD=

# Who receives the report. Several: separated by commas.
EMAIL_TO=your_account@gmail.com
